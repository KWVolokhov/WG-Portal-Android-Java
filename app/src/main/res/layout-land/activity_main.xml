<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Calendar stays on the left with the same width -->
    <com.example.calendar4.RussianCalendarView
        android:id="@+id/calendarView1"
        android:layout_width="@dimen/calendar_width"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="4dp" />

    <!-- Everything that was below the calendar in portrait goes to the right -->
    <ImageButton
        android:id="@+id/button1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ic_add_plus"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Добавить"
        android:onClick="taskAdd"
        app:layout_constraintStart_toEndOf="@id/calendarView1"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/buttonH"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_history_h"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="История"
        android:onClick="openHistory"
        app:layout_constraintStart_toEndOf="@id/button1"
        app:layout_constraintTop_toTopOf="@id/button1" />

    <ListView
        android:id="@+id/listView1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@id/calendarView1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button1"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>