<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:context=".MainActivity">

        <Button
            android:id="@+id/button8"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="%"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/button9"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="0"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/button8" />

        <Button
            android:id="@+id/button7"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginBottom="48dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="4"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button8"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/button15"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginBottom="48dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="6"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button12"
            app:layout_constraintStart_toEndOf="@+id/button16" />

        <Button
            android:id="@+id/button16"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="5"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button13"
            app:layout_constraintStart_toEndOf="@+id/button7" />

        <Button
            android:id="@+id/button13"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="8"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button9"
            app:layout_constraintStart_toEndOf="@+id/button" />

        <Button
            android:id="@+id/button17"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:lineSpacingExtra="36sp"
            android:onClick="onMyButton1Click"
            android:text="1"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button7"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/button18"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:lineSpacingExtra="36sp"
            android:onClick="onMyButton1Click"
            android:text="2"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button16"
            app:layout_constraintStart_toEndOf="@+id/button17" />

        <Button
            android:id="@+id/button19"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:lineSpacingExtra="36sp"
            android:onClick="onMyButton1Click"
            android:text="3"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button15"
            app:layout_constraintStart_toEndOf="@+id/button18" />

        <Button
            android:id="@+id/button11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:lineSpacingExtra="36sp"
            android:onClick="onMyButton1Click"
            android:text="сброс"
            android:textColor="@android:color/holo_red_light"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button17"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/button12"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text=","
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/button9" />

        <Button
            android:id="@+id/button3"
            android:layout_width="89dp"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="из памяти"
            android:textColor="?android:attr/colorEdgeEffect"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button4"
            android:layout_width="89dp"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="память +"
            android:textColor="?android:attr/colorEdgeEffect"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/button3"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button5"
            android:layout_width="89dp"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="память *"
            android:textColor="?android:attr/colorEdgeEffect"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/button4"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button6"
            android:layout_width="89dp"
            android:layout_height="48dp"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="сброс памяти"
            android:textColor="?android:attr/colorEdgeEffect"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/button5"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="7"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button8"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/button14"
            android:layout_width="63dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:onClick="onMyButton1Click"
            android:text="9"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button12"
            app:layout_constraintStart_toEndOf="@+id/button13" />

        <Button
            android:id="@+id/button20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="#FFFFFF"
            android:lineSpacingExtra="36sp"
            android:onClick="onMyButton1Click"
            android:text="лог"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button18"
            app:layout_constraintStart_toEndOf="@+id/button11" />

        <Button
            android:id="@+id/button33"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/holo_blue_light"
            android:onClick="onMyButton1Click"
            android:text="равно"
            android:textColor="@android:color/background_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/button12" />

        <Button
            android:id="@+id/button34"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:onClick="onMyButton1Click"
            android:text="+/-"
            app:layout_constraintBottom_toTopOf="@+id/button33"
            app:layout_constraintStart_toEndOf="@+id/button36" />

        <Button
            android:id="@+id/button35"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:onClick="onMyButton1Click"
            android:text="/"
            app:layout_constraintBottom_toTopOf="@+id/button34"
            app:layout_constraintStart_toEndOf="@+id/button37" />

        <Button
            android:id="@+id/button36"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:onClick="onMyButton1Click"
            android:text="1/X"
            app:layout_constraintBottom_toTopOf="@+id/button33"
            app:layout_constraintStart_toEndOf="@+id/button14" />

        <Button
            android:id="@+id/button37"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:onClick="onMyButton1Click"
            android:text="*"
            app:layout_constraintBottom_toTopOf="@+id/button36"
            app:layout_constraintStart_toEndOf="@+id/button15" />

        <Button
            android:id="@+id/button38"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:onClick="onMyButton1Click"
            android:text="-"
            app:layout_constraintBottom_toTopOf="@+id/button35"
            app:layout_constraintStart_toEndOf="@+id/button39" />

        <Button
            android:id="@+id/button39"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:onClick="onMyButton1Click"
            android:text="+"
            app:layout_constraintBottom_toTopOf="@+id/button37"
            app:layout_constraintStart_toEndOf="@+id/button19" />

        <Button
            android:id="@+id/button2"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="@android:color/background_light"
            android:onClick="onMyButton1Click"
            android:text="доп"
            android:textColor="@android:color/background_dark"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/button39"
            app:layout_constraintStart_toEndOf="@+id/button10" />

        <Button
            android:id="@+id/button10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:backgroundTint="@android:color/background_light"
            android:onClick="onMyButton1Click"
            android:text="формула"
            android:textColor="@android:color/black"
            app:layout_constraintBottom_toTopOf="@+id/button19"
            app:layout_constraintStart_toEndOf="@+id/button20" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="225dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="#FFFFFF"
            android:backgroundTint="#FFFFFF"
            android:text="0"
            android:textAlignment="viewEnd"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="50dp"
            android:layout_height="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="52dp"
            android:text="Память:"
            android:textAlignment="viewStart"
            android:textSize="12sp"
            android:textColor="?android:attr/colorEdgeEffect"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="70dp"
            android:layout_height="15dp"
            android:layout_marginStart="4dp"
            android:text="История:"
            android:textAlignment="viewStart"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="172dp"
            android:layout_height="15dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="52dp"
            android:text="0"
            android:textAlignment="viewEnd"
            android:textSize="12sp"
            android:textColor="?android:attr/colorEdgeEffect"
            app:layout_constraintStart_toEndOf="@+id/textView2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="225dp"
            android:layout_height="90dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/app_name"
            android:text=" "
            android:textAlignment="viewEnd"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView6" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="225dp"
            android:layout_height="15dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/app_name"
            android:gravity="right"
            android:text=" "
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView5"
            tools:textAlignment="viewEnd" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>