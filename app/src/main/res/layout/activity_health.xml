<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: title (left) + "Add" ImageButton + Back ImageButton (right-most) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnNew"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_add_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Добавить запись здоровья"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_cancel_gray"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Filter field (3+ characters filter the list by name) -->
    <EditText
        android:id="@+id/editTextHealthFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Поиск по названию (минимум 3 символа)"
        android:inputType="text"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Health records list (HEALTHPLAN for the selected day) -->
    <ListView
        android:id="@+id/listViewHealth"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>