<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Task 146: заголовок "О Программе" + кнопка назад крестиком (как на других экранах) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="О Программе"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_cancel_gray"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Task 146: допустимая (минимальная) версия Android для запуска приложения -->
    <TextView
        android:id="@+id/textAndroidVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

    <!-- Task 151: текущая версия Android устройства (под допустимой) -->
    <TextView
        android:id="@+id/textCurrentAndroidVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <!-- Task 150: кнопка показа полного соответствия версий API и Android -->
    <Button
        android:id="@+id/btnShowVersions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Показать версии Android"
        android:layout_marginTop="8dp" />

    <!-- Task 146: текущая версия структур баз данных DATABASE_VERSION -->
    <TextView
        android:id="@+id/textDbVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
