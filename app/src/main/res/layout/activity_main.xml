<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.calendar4.RussianCalendarView
        android:id="@+id/calendarView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="0dp" />

    <ListView
        android:id="@+id/listView1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonRowBottomLine"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Contrast line above the button row (portrait only) -->
    <View
        android:id="@+id/buttonRowTopLine"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@drawable/bg_button_row_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendarView1" />

    <!-- Contrast line below the button row -->
    <View
        android:id="@+id/buttonRowBottomLine"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@drawable/bg_button_row_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button1" />

    <View
        android:id="@+id/buttonSpacer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/buttonH"
        app:layout_constraintTop_toTopOf="@id/button1" />

    <ImageButton
        android:id="@+id/button1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ic_add_plus"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Добавить"
        android:onClick="taskAdd"
        app:layout_constraintStart_toEndOf="@id/buttonSpacer"
        app:layout_constraintTop_toBottomOf="@id/buttonRowTopLine" />

    <ImageButton
        android:id="@+id/buttonHealth"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_health_h"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Health"
        android:onClick="openHealth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button1" />

    <ImageButton
        android:id="@+id/buttonH"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_history_h"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="История"
        android:onClick="openHistory"
        app:layout_constraintStart_toEndOf="@id/buttonHealth"
        app:layout_constraintTop_toTopOf="@id/button1" />

    <ImageButton
        android:id="@+id/buttonAction1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_pedometer"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Шагомер"
        android:onClick="onQuickButtonClick"
        app:layout_constraintStart_toEndOf="@id/button1"
        app:layout_constraintTop_toTopOf="@id/button1" />

    <ImageButton
        android:id="@+id/buttonAction2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_burger"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Бургер"
        android:onClick="onQuickButtonClick"
        app:layout_constraintStart_toEndOf="@id/buttonAction1"
        app:layout_constraintTop_toTopOf="@id/button1" />

    <ImageButton
        android:id="@+id/buttonAction3"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_coffee"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Кофе 200"
        android:onClick="onQuickButtonClick"
        app:layout_constraintStart_toEndOf="@id/buttonAction2"
        app:layout_constraintTop_toTopOf="@id/button1" />
    <ImageButton
        android:id="@+id/buttonAction4"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_stress"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Авария"
        android:onClick="onQuickButtonClick"
        app:layout_constraintStart_toEndOf="@id/buttonAction3"
        app:layout_constraintTop_toTopOf="@id/button1" />
    <ImageButton
        android:id="@+id/buttonAction5"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_joy"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Гулянка"
        android:onClick="onQuickButtonClick"
        app:layout_constraintStart_toEndOf="@id/buttonAction4"
        app:layout_constraintTop_toTopOf="@id/button1" />
</androidx.constraintlayout.widget.ConstraintLayout>