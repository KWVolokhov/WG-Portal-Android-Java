<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Task 107: титл + кнопка только назад, как в activity_contacts.xml -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/textViewSmsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СМС"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_cancel_gray"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Filter field (Task 108: минимум 3 символа как в контактах) -->
    <EditText
        android:id="@+id/editTextSmsFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Поиск СМС (минимум 3 символа)"
        android:inputType="text"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Список записей СМС -->
    <ListView
        android:id="@+id/listViewSms"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>